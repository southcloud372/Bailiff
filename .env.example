# DeepSeek（主模型，OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 成本限额（token 经济学，0 = 不限）
DEEPSEEK_COST_LIMIT=0
DEEPSEEK_TOKEN_LIMIT=0

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# 网关鉴权
AGENT_JWT_SECRET=dev-jwt-secret-local-only-0123456789abcdef

# Langfuse（Phase 3 可观测，可选）
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-xxxxxxxx

# 基础设施主机：本机 Docker 用 localhost；Docker 跑在 VMware 虚拟机里时填虚拟机 IP
AGENT_INFRA_HOST=localhost

# 嵌入与向量库（知识库 / 长期记忆）——留空则按 AGENT_INFRA_HOST 推导
AGENT_EMBEDDING_BASE_URL=
AGENT_EMBEDDING_MODEL=bge-m3
AGENT_VECTOR_DSN=

# OpenTelemetry（可选；不配置则为 no-op）
OTEL_EXPORTER_OTLP_ENDPOINT=
