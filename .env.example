# ─────────────────────────────────────────────────────────────────────────────
# 复制为 .env 后按需填写。**所有项都有默认值，不填也能启动**（降级运行）。
# ─────────────────────────────────────────────────────────────────────────────

# ── 模型（DeepSeek，OpenAI 兼容接口）────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash = V4.1-Flash（默认，便宜快）；复杂规划用 deepseek-v4-pro
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 停止服务
DEEPSEEK_MODEL=deepseek-flash
# 模型后端：auto（有 key 用真模型，无 key 自动降级为离线演示模型）
#          deepseek（强制真模型，缺 key 直接报错）/ mock（强制离线，用于 demo 与测试）
AGENT_LLM_BACKEND=auto
# 成本限额（token 经济学，0 = 不限）。超限请求返回 402。
DEEPSEEK_COST_LIMIT=0
DEEPSEEK_TOKEN_LIMIT=0

# ── 运行时后端（决定「笔记本」还是「生产多副本」）──────────────────────────
# checkpoint: memory（仅测试）| sqlite（默认，单机持久化，零依赖）| postgres（多副本）
# 只读模式：true 时不注册写入类工具（公网演示/第三方接入建议打开）
AGENT_READ_ONLY=false
# 允许 Agent 抓取的域名白名单（逗号分隔，支持 *.example.com）。留空 = 不注册 http_fetch
AGENT_HTTP_ALLOWED_HOSTS=

AGENT_CHECKPOINT_BACKEND=sqlite
AGENT_CHECKPOINT_DIR=./data/checkpoints
AGENT_POSTGRES_DSN=postgresql://agent:agent@localhost:5432/agent_platform

# 限流: memory（单副本令牌桶）| redis（跨副本共享配额，故障自动降级到本地）
AGENT_RATE_LIMIT_BACKEND=memory
AGENT_REDIS_URL=redis://localhost:6379/0

# 语义缓存（需要嵌入服务；开启后 /v1/ask 会按语义命中，直接省一次 LLM 调用）
AGENT_CACHE_ENABLED=false
AGENT_CACHE_THRESHOLD=0.95

# ── 运行环境与鉴权 ──────────────────────────────────────────────────────────
# dev 下示例密钥只告警；staging/prod 下 /readyz 直接拒绝（防止带病上线）
AGENT_ENV=dev
# 生产必须换掉：/readyz 会因「密钥仍是示例值」返回 503
AGENT_JWT_SECRET=dev-jwt-secret-local-only-0123456789abcdef

# ── 知识库 / 长期记忆（PostgreSQL + pgvector + 本地嵌入）─────────────────
# 基础设施主机：本机 Docker 用 localhost；Docker 跑在 VMware 虚拟机里时填虚拟机 IP
AGENT_INFRA_HOST=localhost
# 留空则按 AGENT_INFRA_HOST 推导为 http://<host>:11434/v1
AGENT_EMBEDDING_BASE_URL=
# 检索后端：auto/local（SQLite + 哈希嵌入，零依赖）/ postgres（pgvector + 嵌入服务）
AGENT_RAG_BACKEND=auto
# 审计落盘路径（留空 = 仅进程内保留最近 5000 条，不满足合规留存）
AGENT_AUDIT_LOG=
# 单次模型调用超时（秒）
DEEPSEEK_TIMEOUT_SECONDS=60
AGENT_LOCAL_DB_PATH=./data/knowledge.sqlite
AGENT_EMBEDDING_MODEL=bge-m3
# 留空则按 AGENT_INFRA_HOST 推导为 postgresql://agent:agent@<host>:5432/agent_platform
AGENT_VECTOR_DSN=

# ── 外部 MCP server（可选，JSON 数组；启动时自动连接并注册进网关）────────
# 示例：
# AGENT_MCP_SERVERS=[{"name":"fs","transport":"stdio","command":"python","args":["-m","mcp_server_filesystem"]}]
AGENT_MCP_SERVERS=

# ── 可观测（可选；不配置则为 no-op）──────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-xxxxxxxx

# ── 服务监听 ────────────────────────────────────────────────────────────────
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
